# Server configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEV_MODE=1
DEBUG=true

# Security
JWT_SECRET=apex_enterprise_jwt_super_secret_key_change_in_production
APPROVAL_TTL_HOURS=24
AUTO_APPROVE_THRESHOLD_CENTS=0

# Database
# Default: durable SQLite file
DATABASE_URL=sqlite:///./apex_support.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apex_support

# Mock Payment & Logistics Gateways
PAYMENT_GATEWAY_URL=http://127.0.0.1:8001
SHIPPING_GATEWAY_URL=http://127.0.0.1:8002

# Optional LLM integration for Semantic Intent Classification
# Model can be: claude-3-5-haiku-20241022, gpt-4o-mini, gemini-1.5-flash
# If unset or if provider fails, falls back gracefully to deterministic rule-based engine
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=none
